#!/bin/bash

if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS: install Homebrew if missing
    if ! command -v brew &> /dev/null; then
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
    brew list coreutils &>/dev/null || brew install coreutils
fi

# Description: Link dotfiles to home directory

HOST=$(hostname -s)

case "$HOST" in
  cato)
    ln -sf ~/dotfiles/home/zshrc_cato ~/.zshrc
    ;;
  maclab)
    ln -sf ~/dotfiles/home/zshrc_maclab ~/.zshrc
    ;;
  homelab)
    ln -sf ~/dotfiles/home/bashrc_homelab ~/.bashrc
    ;;
  *)
    ln -sf ~/dotfiles/home/bashrc_default ~/.bashrc
    ;;
esac

ln -sf ~/dotfiles/home/vimrc ~/.vimrc
ln -sf ~/dotfiles/home/tmux.conf ~/.tmux.conf

echo "Dotfiles linked successfully."
